# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored, so credentials never reach the repository. The backend loads it
# automatically (spring.config.import in application.properties). Real environment
# variables (shell, IDE run configuration, deployment platform) take precedence over this file.

# --- Mail (Brevo SMTP) ---
# Brevo -> Settings -> SMTP & API gives the SMTP login and a generated SMTP key
# (the key, not your Brevo account password).
MAIL_USERNAME=bcd435001@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-6d42d71fb932bb52689bb930b7b92c6d4a7abcd83189c26c01b6631aaa1973aa-z6cETS2I8YWqqqJm
# The sender address must be verified in Brevo: Contacts -> Senders & IP.
MAIL_FROM=vendra.market.sa@gmail.com
#MAIL_HOST=smtp-relay.brevo.com
#MAIL_PORT=587
#FRONTEND_URL=http://localhost:5173

# --- JWT signing key (local runs fall back to a development key) ---
# Generate one: openssl rand -base64 48
# Leave commented to use the local development default. If you uncomment it, it must
# have a non-empty value of at least 32 bytes or the application refuses to start.
#JWT_SECRET=

# --- Database (local MySQL defaults) ---
#DB_URL=jdbc:mysql://localhost:3306/prm_marketplace?createDatabaseIfNotExist=true
#DB_USERNAME=root
#DB_PASSWORD=password

# --- Admin account created or promoted at startup ---
#ADMIN_EMAIL=admin.vendra@gmail.com
#ADMIN_PASSWORD=

# --- Development toggles ---
#PAYMENT_SIMULATION_ENABLED=true
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
